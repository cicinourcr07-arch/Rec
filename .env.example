# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Static Cloudflare Pages Build)
# ==============================================================================
# All video selection, preview, thumbnail extraction, waveform/audio extraction,
# subtitles, presets, and exports run 100% in the browser via File API + IndexedDB.
# No backend is required for video uploads or playback on Cloudflare Pages.
#
# Optional: Only needed if you also deploy an optional AI backend for automated
# Gemini / Fish Audio API routes (never put API keys in VITE_* variables).
VITE_API_BASE_URL=""

# ==============================================================================
# OPTIONAL SERVER-SIDE AI ENVIRONMENT VARIABLES (Never expose to frontend)
# ==============================================================================
PORT="3000"
NODE_ENV="development"

# Deployed Cloudflare Pages frontend URL(s) allowed by CORS if running the optional AI backend
FRONTEND_URL="https://your-app.pages.dev"
CORS_ORIGINS="https://your-app.pages.dev"

# Server-side AI API Keys (NEVER expose to frontend or VITE_* env vars)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
FISH_AUDIO_API_KEY="your_key_here"
FISH_API_BASE_URL="https://api.fish.audio"

# Optional server runtime directories (only used when running server.ts locally)
STORAGE_DIR="./storage"
APP_URL="MY_APP_URL"
