# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Cloudflare Pages - Build & Edge Proxy)
# ==============================================================================
# Required on Cloudflare Pages: Direct public URL of your deployed Express backend
# (e.g., https://recap-studio-backend.onrender.com — NO trailing slash).
# Never put private API keys in VITE_* variables.
VITE_API_BASE_URL=""

# Optional fallback for Cloudflare Pages Functions (/api/* and /media/* edge proxy).
# Set this in Cloudflare Pages -> Settings -> Environment Variables if you also
# want same-origin /api/* fallback requests proxied to Express.
BACKEND_URL=""

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Node.js Express Server)
# ==============================================================================
# Port injected automatically by Render/Cloud Run (defaults to 3000 locally).
PORT="3000"
NODE_ENV="development"

# Deployed Cloudflare Pages frontend URL(s) allowed by Express CORS
# (comma-separated for multiple domains, e.g. custom domain + *.pages.dev).
FRONTEND_URL="https://your-app.pages.dev"
CORS_ORIGINS="https://your-app.pages.dev"

# Server-side AI API Keys (NEVER expose to frontend or VITE_* env vars)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
FISH_API_KEY="MY_FISH_API_KEY"
FISH_API_BASE_URL="https://api.fish.audio"

# Persistent storage mount path for uploaded videos, thumbnails, exports, fonts,
# and JSON project store. On Render, mount Persistent Disk at /var/data/recap-studio.
STORAGE_DIR="./storage"

# Maximum chunked video upload size in MB (default 2048 MB = 2 GB).
MAX_UPLOAD_SIZE_MB="2048"

# Automatic cleanup threshold (in hours) for orphaned chunk/temp directories.
TEMP_RETENTION_HOURS="24"

# Optional server self-reference URL (injected by AI Studio / Render)
APP_URL="MY_APP_URL"
